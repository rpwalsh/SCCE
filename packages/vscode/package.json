{
  "name": "scce-vscode",
  "displayName": "SCCE",
  "description": "Local VS Code surface for the SCCE cognitive runtime.",
  "version": "0.1.0",
  "private": true,
  "publisher": "walsh-technical-group",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/rpwalsh/SCCE.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://github.com/rpwalsh/SCCE/tree/main/packages/vscode#readme",
  "bugs": {
    "url": "https://github.com/rpwalsh/SCCE/issues"
  },
  "type": "commonjs",
  "main": "./dist/extension.js",
  "types": "./dist/extension.d.ts",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "cognitive engine",
    "local",
    "graph",
    "SCCE"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Workspace ingestion and reviewed patch transactions require a trusted local workspace."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "scce.checkReadiness",
        "title": "SCCE: Check Readiness"
      },
      {
        "command": "scce.setServerToken",
        "title": "SCCE: Set Local Server Token"
      },
      {
        "command": "scce.workspace.initialize",
        "title": "SCCE: Initialize Workspace"
      },
      {
        "command": "scce.workspace.ingest",
        "title": "SCCE: Ingest Workspace"
      },
      {
        "command": "scce.project.summary",
        "title": "SCCE: Show Project Summary"
      },
      {
        "command": "scce.workspace.code",
        "title": "SCCE: Edit File With Compile Gate"
      },
      {
        "command": "scce.workspace.ask",
        "title": "SCCE: Ask About Workspace"
      },
      {
        "command": "scce.workspace.status",
        "title": "SCCE: Show Read-Only Workspace Status"
      },
      {
        "command": "scce.workspace.codingRequest",
        "title": "SCCE: Plan and Apply Coding Request"
      },
      {
        "command": "scce.workspace.applyPatchPlan",
        "title": "SCCE: Apply Reviewed Patch Transaction"
      },
      {
        "command": "scce.tasks.clear",
        "title": "SCCE: Clear Task Timeline"
      },
      {
        "command": "scce.learning.review",
        "title": "SCCE: Review Learned Material"
      },
      {
        "command": "scce.learning.curriculum",
        "title": "SCCE: What SCCE Wants To Learn"
      },
      {
        "command": "scce.settings.open",
        "title": "SCCE: Open Settings"
      },
      {
        "command": "scce.settings.push",
        "title": "SCCE: Push VS Code Settings To Server Config"
      },
      {
        "command": "scce.models.manage",
        "title": "SCCE: Manage Local Models"
      }
    ],
    "configuration": {
      "title": "SCCE",
      "properties": {
        "scce.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:3873",
          "description": "Local SCCE server origin. Only localhost, 127.0.0.0/8, and ::1 are accepted."
        },
        "scce.requestTimeoutMs": {
          "type": "number",
          "default": 120000,
          "minimum": 1000,
          "maximum": 600000,
          "description": "Maximum duration for one SCCE HTTP request."
        },
        "scce.realization.provider": {
          "type": "string",
          "enum": [
            "native",
            "ollama",
            "api"
          ],
          "default": "native",
          "description": "Realization provider. native = SCCE's own mouth (default). ollama = local Ollama (loopback only). api = remote API; requires the server-side acknowledgement that evidence leaves this device."
        },
        "scce.realization.ollamaHost": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama host. Only loopback hosts are accepted."
        },
        "scce.realization.ollamaModel": {
          "type": "string",
          "default": "",
          "description": "Ollama model name used when the provider is ollama."
        },
        "scce.ingestion.imageEmbeddings": {
          "type": "boolean",
          "default": false,
          "description": "Compute visual embeddings for images and rendered PDF pages (requires a locally downloaded CLIP model)."
        },
        "scce.ingestion.camera.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable live camera/video ingestion sources configured on the server. Off by default; active sources are logged."
        },
        "scce.ingestion.camera.device": {
          "type": "string",
          "default": "",
          "description": "Sensor id (from the server's ingestion.sensors) to run when camera ingestion is enabled."
        },
        "scce.workspace.autoIngest": {
          "type": "boolean",
          "default": true,
          "description": "Ingest the opened workspace folder automatically when SCCE binds to it. Opening the workspace in SCCE is the consent."
        },
        "scce.observation.screen": {
          "type": "boolean",
          "default": false,
          "description": "Opt in to observing screen contents beyond the open workspace. Off by default; logged whenever active."
        },
        "scce.observation.otherApplications": {
          "type": "boolean",
          "default": false,
          "description": "Opt in to observing other running applications. Off by default; logged whenever active."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "scce",
          "title": "SCCE",
          "icon": "media/scce.svg"
        }
      ]
    },
    "views": {
      "scce": [
        {
          "id": "scce.chat",
          "name": "Chat",
          "type": "webview"
        },
        {
          "id": "scce.taskTimeline",
          "name": "Activity",
          "visibility": "collapsed"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "scce.checkReadiness",
          "when": "view == scce.taskTimeline",
          "group": "navigation"
        },
        {
          "command": "scce.tasks.clear",
          "when": "view == scce.taskTimeline",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --root ../.. packages/vscode/src/__tests__",
    "test:host": "pnpm package && node ./test/run-extension-host.cjs",
    "vscode:prepublish": "pnpm build",
    "package": "node ./scripts/package-extension.cjs",
    "package:list": "pnpm build && vsce ls --tree"
  },
  "devDependencies": {
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "@types/vscode": "^1.96.0",
    "tslib": "^2.8.1"
  }
}
