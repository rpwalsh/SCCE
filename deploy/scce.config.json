{
  "server": {
    "url": "http://127.0.0.1:3873",
    "host": "0.0.0.0",
    "port": 3873
  },
  "database": {
    "url": "postgresql://scce@postgres:5432/scce_container",
    "schema": "scce6_runtime"
  },
  "runtime": {
    "workspaceRoot": "/workspace",
    "tempRoot": "/scratch/scce-runs",
    "maxFileBytes": 67108864,
    "maxChunkBytes": 4096,
    "spreadsheet": {
      "maxSourceBytes": 67108864,
      "maxSheets": 32,
      "maxRowsPerSheet": 2000,
      "maxColumnsPerSheet": 128,
      "maxCells": 100000,
      "maxDenseCells": 1000000,
      "maxFormulas": 10000,
      "maxMergedRanges": 10000,
      "maxCellChars": 32768,
      "maxTextChars": 8388608,
      "maxArchiveEntries": 4096,
      "maxArchiveEntryBytes": 134217728,
      "maxArchiveUncompressedBytes": 268435456,
      "maxArchiveCompressionRatio": 250,
      "maxParseMs": 30000,
      "maxHeapMb": 384
    },
    "allowedRoots": [
      "/workspace",
      "/data/corpora",
      "/data/models",
      "/scratch"
    ],
    "excludedPaths": [
      "/workspace/node_modules",
      "/workspace/dist",
      "/workspace/.git"
    ],
    "tools": {
      "node": "node",
      "pnpm": "pnpm",
      "pdftoppm": "pdftoppm"
    },
    "patchValidation": {
      "provider": "trusted-host"
    },
    "corpora": {
      "wikipedia": {
        "enabled": true,
        "dumpPath": "/data/corpora/wikipedia/enwiki-latest-pages-articles-multistream.xml.bz2",
        "indexPath": "/data/corpora/wikipedia/enwiki-latest-pages-articles-multistream-index.txt",
        "namespace": "wikipedia-enwiki",
        "python": "python3",
        "decompressor": "bzip2",
        "decompressorArgs": [
          "-dc",
          "{dumpPath}"
        ],
        "maxPagesPerRun": 2500,
        "maxBlocksPerRun": 0,
        "maxArticleChars": 160000,
        "maxBlockBytes": 201326592,
        "memorySafetyBoundMb": 3072,
        "checkpointEveryPages": 1000,
        "ngramMaxCountersPerOrder": 12000,
        "ngramVocabularyLimit": 24000,
        "skipRedirects": true,
        "allowedNamespaces": [
          0
        ]
      },
      "gutenberg": {
        "enabled": true,
        "rootPath": "/data/corpora/gutenberg"
      },
      "oss": {
        "enabled": true,
        "rootPath": "/data/corpora/oss"
      },
      "registry": {
        "dialogue": {
          "enabled": true,
          "localPath": "/data/corpora/dialogue"
        }
      }
    },
    "allowSyntheticRequestRequirementBootstrap": true,
    "functionalCognitionAuthorizeCapabilities": true,
    "dreamCycle": {
      "enabled": false
    }
  },
  "connectors": {
    "web": {
      "enabled": true,
      "accessScope": "public-internet",
      "runtimeAcquisition": "automatic",
      "requestsPerMinute": 30,
      "maxRequestsPerTurn": 12,
      "allowedHosts": [
        "html.duckduckgo.com",
        "duckduckgo.com",
        "en.wikipedia.org"
      ],
      "maxBytes": 2000000,
      "search": {
        "provider": "duckduckgo",
        "apiKey": "",
        "endpoint": ""
      }
    },
    "outlook": {
      "enabled": false,
      "tenantId": "",
      "clientId": "",
      "accessToken": ""
    },
    "youtube": {
      "enabled": false,
      "apiKey": ""
    },
    "telephone": {
      "enabled": false,
      "provider": "twilio",
      "accountSid": "",
      "authToken": "",
      "fromNumber": ""
    }
  },
  "security": {
    "localMasterKey": "",
    "mentalHealthRails": true,
    "redactPublicConfig": true,
    "informationAccess": {
      "tenantId": "scce.local",
      "principalId": "scce.local.owner",
      "compartments": [
        "scce.cognitive"
      ],
      "maximumExportClass": "restricted",
      "explicitMergeAuthority": true
    },
    "defaultSourceInformationLabel": {
      "tenantId": "scce.local",
      "principals": [
        "scce.local.owner"
      ],
      "compartments": [
        "scce.cognitive"
      ],
      "exportClass": "confidential",
      "mergePolicy": "same_owner"
    }
  },
  "policy": {
    "allowMutation": false,
    "requireTwoPhaseCommit": true,
    "dryRunByDefault": true,
    "maxNetworkRequests": 12,
    "maxToolCalls": 24,
    "maxSpendCents": 0,
    "alphaRiskCeiling": 0.55,
    "encryptSecretsAtRest": true
  }
}
