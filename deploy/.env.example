# Optional overrides; copy to an ignored deploy/.env.local and pass --env-file.
# Run node tools/container-init.mjs once for local secrets and empty mount directories.
SCCE_REVISION=development
SCCE_SERVER_PORT=3874
SCCE_CONFIG_PATH=./deploy/scce.config.json
SCCE_CORPUS_ROOT=./data/corpora
SCCE_MODEL_ROOT=./models
SCCE_RESULTS_ROOT=./artifacts/container
SCCE_PG_PASSWORD_FILE=./.scce/docker/postgres-password
SCCE_API_TOKEN_FILE=./.scce/docker/api-token
SCCE_ALLOW_AUTOMATIC_WEB=0
