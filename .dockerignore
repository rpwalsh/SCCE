# Default deny: the image context is an explicit source/build/evaluation allowlist.
**

# Build inputs and public repository material.
!Dockerfile
!.dockerignore
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.json
!tsconfig.base.json
!vitest.config.ts
!models.declared.json
!LICENSE
!NOTICE
!packages/
!packages/**
!tools/
!tools/**
!docs/
!docs/**
!config/
!config/**
!vendor/
!vendor/**
!deploy/
!deploy/**

# Never send host-installed or generated build content.
node_modules/
**/node_modules/
dist/
**/dist/
coverage/
**/coverage/
packages/vscode/.vscode-test/
packages/vscode/.vscode-test/**
**/*.tsbuildinfo

# Never send corpora, brain/checkpoint/learned state, private workspaces, or runtime data.
corpus/
corpus/**
data/
data/**
models/
models/**
brains/
brains/**
checkpoints/
checkpoints/**
learned/
learned/**
**/models/
**/models/**
**/brains/
**/brains/**
**/checkpoints/
**/checkpoints/**
**/*learned-state*
**/*learnedstate*
private/
private/**
private-runtime/
private-runtime/**
demo-workspace/
demo-workspace/**

# Evaluation source/fixtures remain available; generated reports and archives do not.
tools/**/artifacts/
tools/**/artifacts/**
tools/**/.scce/
tools/**/.scce/**
tools/**/reports/
tools/**/reports/**
tools/**/report/
tools/**/report/**
tools/**/archives/
tools/**/archives/**
tools/**/archive/
tools/**/archive/**

# Local credentials, configuration overlays, and environment material.
.env
.env.*
**/.env
**/.env.*
*.env
*.env.*
scce.config*.json
**/scce.config*.json
config/*.production.json
config/**/*.production.json
**/*.local.json
**/*.local.yaml
**/*.local.yml
**/*.pem
**/*.key
**/.pgpass

# Repository metadata and editor/OS noise.
.git/
.git/**
.agent/
.claude/
.scce/
.scce/**
.tmp/
.tmp/**
.tmp-multilingual/
.tmp-multilingual/**
.vscode/
.vscode/**
**/.DS_Store
**/*.log
**/*.tmp
